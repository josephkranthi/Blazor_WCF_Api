@page "/employees"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject BlazorApp1.Services.EmployeeApiService Api

<h3>Employees</h3>

<button type="button" class="btn btn-primary" @onclick="New">New Employee</button>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{ 

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Salary</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Name</td>
                    <td>@e.Salary</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => Edit(e)">Edit</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => Delete(e.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editing)
{
    <div class="card p-3">
        <h4>@(editEmployee.Id == 0 ? "Create" : "Edit") Employee</h4>
        <div class="mb-2">
            <label>Name</label>
            <input class="form-control" @bind="editEmployee.Name" />
        </div>
        <div class="mb-2">
            <label>Salary</label>
            <input class="form-control" type="number" step="0.01" @bind="editEmployee.Salary" />
        </div>
        <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </div>
}

@code {
    private List<BlazorApp1.Models.Employee> employees = new();
    private bool isLoading = true;
    private bool editing = false;
    private BlazorApp1.Models.Employee editEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        employees = await Api.GetAllAsync();
        isLoading = false;
        StateHasChanged();
    }

    private void New()
    {
        editEmployee = new BlazorApp1.Models.Employee();
        editing = true;
    }

    private void Edit(BlazorApp1.Models.Employee e)
    {      
        editEmployee = new BlazorApp1.Models.Employee { Id = e.Id, Name = e.Name, Salary = e.Salary };
        editing = true;
    }

    private async Task Save()
    {
        if (editEmployee.Id == 0)
        {
            await Api.CreateAsync(editEmployee);
        }
        else
        {
            await Api.UpdateAsync(editEmployee.Id, editEmployee);
        }

        editing = false;
        await Load();
    }

    private async Task Delete(int id)
    {
        await Api.DeleteAsync(id);
        await Load();
    }

    private void Cancel()
    {
        editing = false;
    }
}
